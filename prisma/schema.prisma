// Voz de Torres Vedras — modelo de dados de uma plataforma pública, só de leitura.
//
// Regras estruturais:
// - Fontes: tudo o que é factual liga a registos `Source`.
// - `updatedAt`: data da última recolha ou verificação na fonte, não da escrita na base de dados.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Body {
  ASSEMBLEIA_MUNICIPAL
  EXECUTIVO_MUNICIPAL
}

enum MeetingStatus {
  CONVOCADA
  REALIZADA
}

enum AgendaStatus {
  NAO_PUBLICADA
  PUBLICADA
}

enum Outcome {
  APROVADO
  REPROVADO
  ADIADO
  RETIRADO
  TOMADA_CONHECIMENTO
  REMETIDO
  POR_PUBLICAR
}

enum VoteMode {
  UNANIMIDADE
  MAIORIA
  NAO_APLICAVEL
}

enum VoteChoice {
  FAVOR
  CONTRA
  ABSTENCAO
}

enum SourceType {
  ATA
  MINUTA
  VIDEO
  AGENDA
  EDITAL
  DOCUMENTO_PDF
  ORCAMENTO
  CONTRATO
  DIARIO_REPUBLICA
  PAGINA_OFICIAL
  DATASET
}

enum ContentKind {
  REGISTO_OFICIAL
  CONTEXTO_EDITORIAL
}

enum BudgetKind {
  RESUMO
  RECEITA
  DESPESA
  SITUACAO_FINANCEIRA
}

// ---------- Dossiês ----------

model Issue {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  summary   String
  stage     String
  updatedAt DateTime @default(now())

  dates     IssueDate[]
  claims    Claim[]
  decisions Decision[]
  sources   Source[]

  @@index([category])
}

model IssueDate {
  id      String   @id @default(cuid())
  issueId String
  date    DateTime
  label   String
  issue   Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// ---------- Registo oficial ----------

model Meeting {
  id            String        @id @default(cuid())
  slug          String        @unique
  body          Body
  date          DateTime
  // Falso quando a fonte não indica hora.
  hasTime       Boolean       @default(true)
  title         String
  location      String?
  status        MeetingStatus @default(REALIZADA)
  agendaStatus  AgendaStatus  @default(PUBLICADA)
  participation String?
  updatedAt     DateTime      @default(now())
  decisions     Decision[]
  sources       Source[]

  @@index([date])
}

model Decision {
  id           String   @id @default(cuid())
  slug         String   @unique
  meetingId    String
  itemNumber   String?
  proposalRef  String?
  title        String
  outcome      Outcome
  voteMode     VoteMode @default(NAO_APLICAVEL)
  votesFor     Int?
  votesAgainst Int?
  abstentions  Int?
  // Sentido de voto por grupo, quando a ata o indica.
  voteNote     String?
  updatedAt    DateTime @default(now())
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  votes        VoteRecord[]
  issues       Issue[]
  sources      Source[]

  @@index([meetingId])
  @@index([outcome])
}

// Voto de eleitos em órgãos municipais. Só existe quando a fonte oficial o identifica.
model VoteRecord {
  id         String     @id @default(cuid())
  decisionId String
  officialId String
  choice     VoteChoice
  decision   Decision   @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  official   Official   @relation(fields: [officialId], references: [id], onDelete: Cascade)

  @@unique([decisionId, officialId])
}

model Official {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  role        String
  body        Body
  // Nulo quando a fonte consultada não indica partido ou coligação.
  party       String?
  parish      String?
  portfolios  String[]
  order       Int      @default(100)
  active      Boolean  @default(true)
  updatedAt   DateTime @default(now())
  memberships CommitteeMembership[]
  votes       VoteRecord[]
  sources     Source[]

  @@index([body, order])
}

model Committee {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  body    Body
  members CommitteeMembership[]
  sources Source[]
}

model CommitteeMembership {
  committeeId String
  officialId  String
  isChair     Boolean   @default(false)
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  official    Official  @relation(fields: [officialId], references: [id], onDelete: Cascade)

  @@id([committeeId, officialId])
}

// ---------- Fontes ----------

model Source {
  id          String     @id @default(cuid())
  name        String
  title       String
  url         String     @unique
  type        SourceType
  official    Boolean    @default(true)
  publishedAt DateTime?
  retrievedAt DateTime
  excerpt     String?
  importRunId String?
  importRun   ImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  issues     Issue[]
  meetings   Meeting[]
  decisions  Decision[]
  officials  Official[]
  committees Committee[]
  claims     Claim[]
  contracts  Contract[]
  budget     BudgetEntry[]

  @@index([type])
}

model Claim {
  id        String      @id @default(cuid())
  text      String
  kind      ContentKind @default(CONTEXTO_EDITORIAL)
  issueId   String?
  createdAt DateTime    @default(now())
  issue     Issue?      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sources   Source[]
}

// ---------- Dados públicos ----------

model Contract {
  id               String     @id @default(cuid())
  baseId           String     @unique
  title            String
  awardingBody     String
  awardingNif      String
  // Em pessoas singulares não se republica nome nem NIF: remete-se para o Portal BASE.
  supplierName     String
  supplierNif      String?
  supplierIsPerson Boolean    @default(false)
  procedureType    String
  contractType     String?
  cpvCode          String?
  cpvLabel         String?
  priceEur         Decimal    @db.Decimal(14, 2)
  signedAt         DateTime?
  publishedAt      DateTime?
  durationDays     Int?
  updatedAt        DateTime   @default(now())
  importRunId      String?
  importRun        ImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  sources          Source[]

  @@index([signedAt])
  @@index([awardingNif])
  @@index([procedureType])
}

model BudgetEntry {
  id          String     @id @default(cuid())
  year        Int
  kind        BudgetKind
  label       String
  amountEur   Decimal    @db.Decimal(14, 2)
  // Verdadeiro quando a fonte indica um valor aproximado ("cerca de").
  approximate Boolean    @default(false)
  asOf        DateTime?
  note        String?
  updatedAt   DateTime   @default(now())
  sources     Source[]

  @@index([year, kind])
}

// ---------- Importação ----------

model ImportRun {
  id          String     @id @default(cuid())
  dataset     String
  sourceUrl   String
  fileName    String
  sha256      String
  retrievedAt DateTime
  imported    Int        @default(0)
  skipped     Int        @default(0)
  errors      Json?
  createdAt   DateTime   @default(now())
  sources     Source[]
  contracts   Contract[]
}
