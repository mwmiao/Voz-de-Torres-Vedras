# Base de dados
DATABASE_URL="postgresql://voz:voz_local@localhost:5432/voz_tv?schema=public"

# URL público da aplicação (usado nas ligações enviadas por email)
APP_URL="http://localhost:1400"

# Segredo para HMAC de emails e IP. Gerar com: openssl rand -hex 32
# Obrigatório em produção.
AUTH_SECRET="substituir-por-um-valor-aleatorio-longo"

# Emails com papel de administração, separados por vírgulas.
# Só são comparados por hash no momento da entrada: não ficam guardados na base de dados.
ADMIN_EMAILS=""
MODERATOR_EMAILS=""

# SMTP. Se SMTP_HOST ficar vazio fora de produção, a ligação de entrada é escrita na consola.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Voz de Torres Vedras <nao-responder@exemplo.pt>"

# Dados de exemplo no seed. Por omissão, são criados fora de produção.
SEED_EXAMPLES="true"
