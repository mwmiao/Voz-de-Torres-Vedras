// Voz de Torres Vedras — modelo de dados de uma plataforma pública, só de leitura, em SQLite.
//
// Regras estruturais:
// - Fontes: tudo o que é factual liga a registos `Source`.
// - `updatedAt`: data da última recolha ou verificação na fonte, não da escrita na base de dados.
// - `dataSourceId`: identificador da origem no catálogo de src/lib/source-catalog.ts.
// - `searchText`: texto sem acentos nem maiúsculas, porque o LIKE do SQLite só ignora maiúsculas em ASCII.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Body {
  ASSEMBLEIA_MUNICIPAL
  EXECUTIVO_MUNICIPAL
}

enum MeetingStatus {
  CONVOCADA
  REALIZADA
}

enum AgendaStatus {
  NAO_PUBLICADA
  PUBLICADA
}

enum Outcome {
  APROVADO
  REPROVADO
  ADIADO
  RETIRADO
  TOMADA_CONHECIMENTO
  REMETIDO
  POR_PUBLICAR
}

enum VoteMode {
  UNANIMIDADE
  MAIORIA
  NAO_APLICAVEL
}

enum VoteChoice {
  FAVOR
  CONTRA
  ABSTENCAO
}

enum SourceType {
  ATA
  MINUTA
  VIDEO
  AGENDA
  EDITAL
  DOCUMENTO_PDF
  ORCAMENTO
  CONTRATO
  DIARIO_REPUBLICA
  PAGINA_OFICIAL
  DATASET
  REGULAMENTO
  CONCURSO
}

enum UpdateStatus {
  NEW
  UPDATED
  UNCHANGED
  FAILED
}

enum SourceRunStatus {
  OK
  PARCIAL
  ERRO
  NUNCA_EXECUTADA
}

enum UpdateCategory {
  CONTRATO
  ORCAMENTO
  REUNIAO
  DOCUMENTO
  ELEITO
  SEGURANCA
  ALERTA
}

enum ContentKind {
  REGISTO_OFICIAL
  CONTEXTO_EDITORIAL
}

enum BudgetKind {
  RESUMO
  RECEITA
  DESPESA
  SITUACAO_FINANCEIRA
}

// ---------- Dossiês ----------

model Issue {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  summary   String
  stage     String
  updatedAt DateTime @default(now())

  dates     IssueDate[]
  claims    Claim[]
  decisions Decision[]
  sources   Source[]

  @@index([category])
}

model IssueDate {
  id      String   @id @default(cuid())
  issueId String
  date    DateTime
  label   String
  issue   Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([issueId])
}

// ---------- Registo oficial ----------

model Meeting {
  id            String        @id @default(cuid())
  slug          String        @unique
  body          Body
  date          DateTime
  // Falso quando a fonte não indica hora.
  hasTime       Boolean       @default(true)
  title         String
  location      String?
  status        MeetingStatus @default(REALIZADA)
  agendaStatus  AgendaStatus  @default(PUBLICADA)
  participation String?
  updatedAt     DateTime      @default(now())
  dataSourceId  String?
  updateStatus  UpdateStatus  @default(UNCHANGED)
  decisions     Decision[]
  sources       Source[]

  @@index([date])
}

model Decision {
  id           String   @id @default(cuid())
  slug         String   @unique
  meetingId    String
  itemNumber   String?
  proposalRef  String?
  title        String
  outcome      Outcome
  voteMode     VoteMode @default(NAO_APLICAVEL)
  votesFor     Int?
  votesAgainst Int?
  abstentions  Int?
  // Sentido de voto por grupo, quando a ata o indica.
  voteNote     String?
  updatedAt    DateTime @default(now())
  searchText   String   @default("")
  dataSourceId String?
  updateStatus UpdateStatus @default(UNCHANGED)
  meeting      Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  votes        VoteRecord[]
  issues       Issue[]
  sources      Source[]

  @@index([meetingId])
  @@index([outcome])
}

// Voto de eleitos em órgãos municipais. Só existe quando a fonte oficial o identifica.
model VoteRecord {
  id         String     @id @default(cuid())
  decisionId String
  officialId String
  choice     VoteChoice
  decision   Decision   @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  official   Official   @relation(fields: [officialId], references: [id], onDelete: Cascade)

  @@unique([decisionId, officialId])
}

model Official {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  role        String
  body        Body
  // Nulo quando a fonte consultada não indica partido ou coligação.
  party       String?
  parish      String?
  portfolios  Json     @default("[]")
  order       Int      @default(100)
  active      Boolean  @default(true)
  updatedAt   DateTime @default(now())
  dataSourceId String?
  updateStatus UpdateStatus @default(UNCHANGED)
  memberships CommitteeMembership[]
  votes       VoteRecord[]
  sources     Source[]

  @@index([body, order])
}

model Committee {
  id      String  @id @default(cuid())
  slug    String  @unique
  name    String
  body    Body
  members CommitteeMembership[]
  sources Source[]
}

model CommitteeMembership {
  committeeId String
  officialId  String
  isChair     Boolean   @default(false)
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  official    Official  @relation(fields: [officialId], references: [id], onDelete: Cascade)

  @@id([committeeId, officialId])
}

// ---------- Fontes ----------

model Source {
  id          String     @id @default(cuid())
  name        String
  title       String
  url         String     @unique
  type        SourceType
  official    Boolean    @default(true)
  publishedAt DateTime?
  retrievedAt DateTime
  excerpt     String?
  // Dados estruturados normalizados da fonte, em JSON.
  data        Json?
  contentHash String?
  firstSeenAt DateTime   @default(now())
  searchText  String     @default("")
  dataSourceId String?
  updateStatus UpdateStatus @default(UNCHANGED)
  importRunId String?
  importRun   ImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)

  issues     Issue[]
  meetings   Meeting[]
  decisions  Decision[]
  officials  Official[]
  committees Committee[]
  claims     Claim[]
  contracts  Contract[]
  budget     BudgetEntry[]

  @@index([type])
}

model Claim {
  id        String      @id @default(cuid())
  text      String
  kind      ContentKind @default(CONTEXTO_EDITORIAL)
  issueId   String?
  createdAt DateTime    @default(now())
  issue     Issue?      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  sources   Source[]
}

// ---------- Dados públicos ----------

model Contract {
  id               String     @id @default(cuid())
  baseId           String     @unique
  title            String
  awardingBody     String
  awardingNif      String
  // Em pessoas singulares não se republica nome nem NIF: remete-se para o Portal BASE.
  supplierName     String
  supplierNif      String?
  supplierIsPerson Boolean    @default(false)
  procedureType    String
  contractType     String?
  cpvCode          String?
  cpvLabel         String?
  priceEur         Decimal   
  signedAt         DateTime?
  publishedAt      DateTime?
  durationDays     Int?
  updatedAt        DateTime   @default(now())
  searchText       String     @default("")
  dataSourceId     String?
  updateStatus     UpdateStatus @default(UNCHANGED)
  importRunId      String?
  importRun        ImportRun? @relation(fields: [importRunId], references: [id], onDelete: SetNull)
  sources          Source[]
  modifications    ContractModification[]

  @@index([signedAt])
  @@index([awardingNif])
  @@index([procedureType])
}

model ContractModification {
  id         String    @id @default(cuid())
  baseId     String
  date       DateTime?
  actType    String?
  grounds    String?
  // Preço do contrato depois da modificação, quando publicado.
  newPriceEur Decimal?
  newDurationDays Int?
  publishedAt DateTime?
  sourceUrl  String
  dataSourceId String?
  updatedAt  DateTime  @default(now())
  contract   Contract  @relation(fields: [baseId], references: [baseId], onDelete: Cascade)

  @@unique([baseId, date, actType])
}

model BudgetEntry {
  id          String     @id @default(cuid())
  year        Int
  kind        BudgetKind
  label       String
  amountEur   Decimal   
  // Verdadeiro quando a fonte indica um valor aproximado ("cerca de").
  approximate Boolean    @default(false)
  asOf        DateTime?
  note        String?
  updatedAt   DateTime   @default(now())
  dataSourceId String?
  updateStatus UpdateStatus @default(UNCHANGED)
  sources     Source[]

  @@index([year, kind])
}

// ---------- Importação e atualizações ----------

model ImportRun {
  id           String     @id @default(cuid())
  dataset      String
  dataSourceId String?
  sourceUrl    String
  fileName     String
  sha256       String
  retrievedAt  DateTime
  imported     Int        @default(0)
  skipped      Int        @default(0)
  newCount     Int        @default(0)
  updatedCount Int        @default(0)
  unchangedCount Int      @default(0)
  failedCount  Int        @default(0)
  errors       Json?
  createdAt    DateTime   @default(now())
  sources      Source[]
  contracts    Contract[]
  events       UpdateEvent[]
}

// Estado de cada origem do catálogo. A definição da origem está no código.
model DataSourceState {
  id            String          @id
  lastRunAt     DateTime?
  lastSuccessAt DateTime?
  lastStatus    SourceRunStatus @default(NUNCA_EXECUTADA)
  lastError     String?
  // Última revisão publicada pela origem, para não voltar a descarregar o que não mudou.
  revision      String?
  newCount      Int             @default(0)
  updatedCount  Int             @default(0)
  unchangedCount Int            @default(0)
  failedCount   Int             @default(0)
}

// Histórico público: o que entrou ou mudou, quando e com que fonte.
model UpdateEvent {
  id           String         @id @default(cuid())
  dataSourceId String
  runId        String?
  entityType   String
  entityKey    String
  status       UpdateStatus
  category     UpdateCategory
  title        String
  sourceUrl    String
  occurredAt   DateTime
  run          ImportRun?     @relation(fields: [runId], references: [id], onDelete: SetNull)
  changes      FieldChange[]

  @@index([occurredAt])
  @@index([entityType, entityKey])
}

// Versões anteriores: cada campo alterado guarda o valor antigo e o novo.
model FieldChange {
  id       String      @id @default(cuid())
  eventId  String
  field    String
  oldValue String?
  newValue String?
  event    UpdateEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

// ---------- Resumos, métricas, segurança e alertas ----------
//
// Todos estes modelos têm os mesmos oito campos de proveniência, com os nomes de coluna
// source_id, source_url, publication_date, retrieval_date, geographic_area,
// geographic_area_type, data_period e update_status.

enum GeographicAreaType {
  CONCELHO
  FREGUESIA
}

enum AlertType {
  METEOROLOGIA
  PROTECAO_CIVIL
  MOBILIDADE
  AGUA
  RESIDUOS
  SAUDE
  SERVICOS
  SEGURANCA
  CONSULTA
  AVISO_MUNICIPAL
}

enum AlertSeverity {
  INFORMATIVO
  ATENCAO
  IMPORTANTE
  CRITICO
}

// Gerado por regras a partir de campos oficiais: ver src/lib/summaries.ts.
model Summary {
  id                 String             @id @default(cuid())
  entityType         String
  entityKey          String
  title              String
  // Falso quando a fonte é demasiado ambígua para resumir.
  available          Boolean            @default(true)
  simple             String?
  meaning            String?
  decidedBy          String
  status             String
  date               DateTime?
  // Página da plataforma com o registo completo, quando existe.
  href               String?
  contentHash        String
  searchText         String             @default("")
  sourceId           String             @map("source_id")
  sourceUrl          String             @map("source_url")
  publicationDate    DateTime?          @map("publication_date")
  retrievalDate      DateTime           @map("retrieval_date")
  geographicArea     String             @default("Torres Vedras") @map("geographic_area")
  geographicAreaType GeographicAreaType @default(CONCELHO) @map("geographic_area_type")
  dataPeriod         String             @default("") @map("data_period")
  updateStatus       UpdateStatus       @default(NEW) @map("update_status")

  @@unique([entityType, entityKey])
  @@index([date])
  @@map("summaries")
}

model Metric {
  id                 String             @id @default(cuid())
  key                String
  // Subdivisão do valor, como um tipo de procedimento. Vazio no total.
  dimension          String             @default("")
  period             String
  value              Float
  unit               String
  sourceId           String             @map("source_id")
  sourceUrl          String             @map("source_url")
  publicationDate    DateTime?          @map("publication_date")
  retrievalDate      DateTime           @map("retrieval_date")
  geographicArea     String             @default("Torres Vedras") @map("geographic_area")
  geographicAreaType GeographicAreaType @default(CONCELHO) @map("geographic_area_type")
  dataPeriod         String             @default("") @map("data_period")
  updateStatus       UpdateStatus       @default(NEW) @map("update_status")

  @@unique([key, dimension, period])
  @@index([key])
  @@map("metrics")
}

model CrimeCategory {
  id                 String             @id @default(cuid())
  code               String             @unique
  name               String
  // Grupo em linguagem simples, para filtrar.
  group              String
  order              Int                @default(100)
  sourceId           String             @map("source_id")
  sourceUrl          String             @map("source_url")
  publicationDate    DateTime?          @map("publication_date")
  retrievalDate      DateTime           @map("retrieval_date")
  geographicArea     String             @default("Torres Vedras") @map("geographic_area")
  geographicAreaType GeographicAreaType @default(CONCELHO) @map("geographic_area_type")
  dataPeriod         String             @default("") @map("data_period")
  updateStatus       UpdateStatus       @default(NEW) @map("update_status")
  records            CrimeRecord[]

  @@map("crime_categories")
}

// Só dados agregados: nunca há informação sobre vítimas, suspeitos ou processos.
model CrimeRecord {
  id                 String             @id @default(cuid())
  categoryCode       String
  year               Int
  // Nulo quando a fonte oculta o valor por segredo estatístico.
  count              Int?
  confidential       Boolean            @default(false)
  // Taxa em permilagem publicada pelo INE.
  officialRate       Float?
  // Taxa por 1 000 residentes calculada aqui, com a população do ano indicado.
  calculatedRate     Float?
  populationYear     Int?
  sourceId           String             @map("source_id")
  sourceUrl          String             @map("source_url")
  publicationDate    DateTime?          @map("publication_date")
  retrievalDate      DateTime           @map("retrieval_date")
  geographicArea     String             @default("Torres Vedras") @map("geographic_area")
  geographicAreaType GeographicAreaType @default(CONCELHO) @map("geographic_area_type")
  dataPeriod         String             @default("") @map("data_period")
  updateStatus       UpdateStatus       @default(NEW) @map("update_status")
  category           CrimeCategory      @relation(fields: [categoryCode], references: [code], onDelete: Cascade)

  @@unique([categoryCode, geographicArea, dataPeriod])
  @@index([year])
  @@map("crime_records")
}

model Freguesia {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  sourceId           String             @map("source_id")
  sourceUrl          String             @map("source_url")
  publicationDate    DateTime?          @map("publication_date")
  retrievalDate      DateTime           @map("retrieval_date")
  geographicArea     String             @default("Torres Vedras") @map("geographic_area")
  geographicAreaType GeographicAreaType @default(FREGUESIA) @map("geographic_area_type")
  dataPeriod         String             @default("") @map("data_period")
  updateStatus       UpdateStatus       @default(NEW) @map("update_status")

  @@map("freguesias")
}

model PopulationEstimate {
  id                 String             @id @default(cuid())
  year               Int
  population         Int
  sourceId           String             @map("source_id")
  sourceUrl          String             @map("source_url")
  publicationDate    DateTime?          @map("publication_date")
  retrievalDate      DateTime           @map("retrieval_date")
  geographicArea     String             @default("Torres Vedras") @map("geographic_area")
  geographicAreaType GeographicAreaType @default(CONCELHO) @map("geographic_area_type")
  dataPeriod         String             @default("") @map("data_period")
  updateStatus       UpdateStatus       @default(NEW) @map("update_status")

  @@unique([geographicArea, year])
  @@map("population_estimates")
}

model AlertSource {
  id                 String             @id
  name               String
  sourceId           String             @map("source_id")
  sourceUrl          String             @map("source_url")
  publicationDate    DateTime?          @map("publication_date")
  retrievalDate      DateTime           @map("retrieval_date")
  geographicArea     String             @default("Torres Vedras") @map("geographic_area")
  geographicAreaType GeographicAreaType @default(CONCELHO) @map("geographic_area_type")
  dataPeriod         String             @default("") @map("data_period")
  updateStatus       UpdateStatus       @default(NEW) @map("update_status")
  alerts             Alert[]

  @@map("alert_sources")
}

model Alert {
  id                 String             @id @default(cuid())
  key                String             @unique
  title              String
  type               AlertType
  severity           AlertSeverity
  description        String
  startsAt           DateTime?
  // Fim oficial ou, sem ele, fim do período em que o aviso fica entre os ativos.
  endsAt             DateTime?
  hasOfficialEnd     Boolean            @default(false)
  // Falso quando a fonte só indica dias, para não mostrar uma hora que ela não deu.
  hasTime            Boolean            @default(false)
  lastCheckedAt      DateTime
  contentHash        String
  searchText         String             @default("")
  sourceId           String             @map("source_id")
  sourceUrl          String             @map("source_url")
  publicationDate    DateTime?          @map("publication_date")
  retrievalDate      DateTime           @map("retrieval_date")
  geographicArea     String             @default("Concelho de Torres Vedras") @map("geographic_area")
  geographicAreaType GeographicAreaType @default(CONCELHO) @map("geographic_area_type")
  dataPeriod         String             @default("") @map("data_period")
  updateStatus       UpdateStatus       @default(NEW) @map("update_status")
  source             AlertSource        @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([endsAt])
  @@index([type])
  @@map("alerts")
}

// Uma linha por origem em cada execução.
model DataUpdateLog {
  id                 String             @id @default(cuid())
  status             SourceRunStatus
  newCount           Int                @default(0)
  updatedCount       Int                @default(0)
  unchangedCount     Int                @default(0)
  failedCount        Int                @default(0)
  message            String?
  sourceId           String             @map("source_id")
  sourceUrl          String             @map("source_url")
  publicationDate    DateTime?          @map("publication_date")
  retrievalDate      DateTime           @map("retrieval_date")
  geographicArea     String             @default("Torres Vedras") @map("geographic_area")
  geographicAreaType GeographicAreaType @default(CONCELHO) @map("geographic_area_type")
  dataPeriod         String             @default("") @map("data_period")
  updateStatus       UpdateStatus       @default(UNCHANGED) @map("update_status")

  @@index([retrievalDate])
  @@map("data_update_logs")
}
